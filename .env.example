# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brand_craftsman?sslmode=disable"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="brand_craftsman"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_SSL="false"

# =============================================================================
# Authelia Authentication & SSO Configuration
# =============================================================================
AUTHELIA_URL="http://localhost:9091"
AUTHELIA_ISSUER_URL="http://localhost:9091"
AUTHELIA_CLIENT_ID="brand-craftsman"
AUTHELIA_CLIENT_SECRET="brand-craftsman-authelia-client-secret-key-32chars"

# =============================================================================
# Auth.js (NextAuth.js v5) Configuration
# =============================================================================
AUTH_SECRET="your-32-character-secret-key-goes-here-0123456789"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-32-character-secret-key-goes-here-0123456789"
