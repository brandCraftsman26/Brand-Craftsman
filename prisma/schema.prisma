// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  
  accounts      Account[]
  sessions      Session[]
  
  // AI Platform specific fields
  credits       Int       @default(100) // Free tier default credits
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  generations   AiGeneration[]
  orders        Order[]
  pages         BuilderPage[] // Pages created in the website builder
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom models for AI Platform
model AiGeneration {
  id          String   @id @default(cuid())
  userId      String
  toolName    String   // e.g., "grammar-check", "video-gen", "humanizer"
  prompt      String   @db.Text
  response    String   @db.Text // Or URL to video
  creditsUsed Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  razorpayId    String?  @unique
  planPurchased Plan?    // If they bought a subscription
  amount        Int      // Amount in paise (INR)
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Elementor-like Website Builder Models
model BuilderPage {
  id          String   @id @default(cuid())
  userId      String
  title       String
  slug        String
  contentJson String   @db.Text // Stores the JSON AST of the visual builder
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, slug])
}
// Global Site Configuration
model SiteConfig {
  id              String   @id @default("global")
  siteName        String   @default("Brand Craftsman")
  headerLogoUrl   String?
  footerCopyright String   @default("© 2026 Brand Craftsman. All rights reserved.")
  socialLinks     String?  // JSON string
  updatedAt       DateTime @updatedAt
}
